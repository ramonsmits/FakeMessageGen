<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <!-- Versions follow YYYY.RELEASECOUNT.PATCH (see README), so pre-release builds after a release count up the release number -->
        <MinVerAutoIncrement>minor</MinVerAutoIncrement>
        <!-- Required by the Particular.Msmq sources compiled in below -->
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <!-- CA1416 (platform compatibility) is raised by the MSMQ sources; MSMQ is only selected on Windows at runtime -->
        <NoWarn>$(NoWarn);CA1416</NoWarn>
    </PropertyGroup>

    <PropertyGroup>
        <!--
            The MSMQ transport is distributed as a source package that only targets net10.0-windows. A dotnet tool cannot
            target a Windows specific framework (NETSDK1146), so the packages are downloaded without NuGet asset selection
            and their sources are compiled directly into this net10.0 assembly. The MSMQ transport is only usable on Windows.
        -->
        <MsmqTransportSourcesVersion>4.0.1</MsmqTransportSourcesVersion>
        <ParticularMsmqVersion>2.0.0</ParticularMsmqVersion>
        <MsmqTransportSourcesPath>$(NuGetPackageRoot)nservicebus.transport.msmq.sources/$(MsmqTransportSourcesVersion)/</MsmqTransportSourcesPath>
        <ParticularMsmqPath>$(NuGetPackageRoot)particular.msmq/$(ParticularMsmqVersion)/</ParticularMsmqPath>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Azure.Messaging.ServiceBus" Version="7.21.0"/>
        <PackageReference Include="MinVer" Version="8.0.0">
          <PrivateAssets>all</PrivateAssets>
          <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.Sbom.Targets" Version="4.1.13" PrivateAssets="all" />
        <PackageReference Include="NServiceBus" Version="10.2.9"/>
        <PackageReference Include="NServiceBus.Transport.AzureServiceBus" Version="6.5.0" />
        <PackageReference Include="NServiceBus.RabbitMQ" Version="11.2.1" />
        <PackageReference Include="NuGet.Protocol" Version="7.9.0" />
        <PackageReference Include="NuGet.Versioning" Version="7.9.0" />
        <PackageDownload Include="NServiceBus.Transport.Msmq.Sources" Version="[$(MsmqTransportSourcesVersion)]" />
        <PackageDownload Include="Particular.Msmq" Version="[$(ParticularMsmqVersion)]" />
    </ItemGroup>

    <ItemGroup>
        <Compile Include="$(MsmqTransportSourcesPath)contentFiles/cs/net10.0-windows7.0/**/*.cs" LinkBase="Msmq/NServiceBus.Transport.Msmq" />
        <Compile Include="$(ParticularMsmqPath)contentFiles/cs/net10.0-windows7.0/**/*.cs" LinkBase="Msmq/Particular.Msmq" />
        <EmbeddedResource Include="$(MsmqTransportSourcesPath)build/net10.0-windows7.0/endpoints.xsd" LogicalName="Msmq.InstanceMapping.Validators.endpoints.xsd" Visible="false" />
        <EmbeddedResource Include="$(MsmqTransportSourcesPath)build/net10.0-windows7.0/endpointsV2.xsd" LogicalName="Msmq.InstanceMapping.Validators.endpointsV2.xsd" Visible="false" />
    </ItemGroup>

    <ItemGroup>
        <None Update="original.txt">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
    </ItemGroup>

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <PackageId>NBraceIT.FakeMessageGen</PackageId>
        <Description>Generate fake messages to load test ServiceControl instances</Description>
        <PackageTags>NServiceBus;ServiceControl</PackageTags>
        <ToolCommandName>fakemessagegen</ToolCommandName>
        <PackageOutputPath>./nupkg</PackageOutputPath>
        <PackAsTool>true</PackAsTool>
        <PackageLicenseExpression>AGPL-3.0-only</PackageLicenseExpression>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <!-- Embed an SPDX Software Bill of Materials (_manifest/spdx_2.2/) in the package for supply-chain auditing -->
        <GenerateSBOM>true</GenerateSBOM>
        <RepositoryUrl>https://github.com/ramonsmits/FakeMessageGen</RepositoryUrl>
        <PackageProjectUrl>https://github.com/ramonsmits/FakeMessageGen</PackageProjectUrl>
        <PackageReleaseNotes>$([System.IO.File]::ReadAllText("$(MSBuildProjectDirectory)/../CHANGELOG.md"))</PackageReleaseNotes>
    </PropertyGroup>

    <ItemGroup>
        <None Include="../README.md" Pack="true" PackagePath="/"/>
    </ItemGroup>

    <!-- Microsoft.Sbom.Targets reads $(Version) during evaluation, before MinVer has computed it; re-read it after MinVer runs -->
    <Target Name="SetSbomVersionFromMinVer" AfterTargets="MinVer">
        <PropertyGroup>
            <SbomGenerationPackageVersion>$(PackageVersion)</SbomGenerationPackageVersion>
        </PropertyGroup>
    </Target>
</Project>
